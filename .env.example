# Google Sheet (source of truth)
# Base64 of the service-account JSON: base64 -w0 creed-sheets-creds.json
GOOGLE_SA_JSON_B64=base64-encoded-service-account-json
# Or for local dev, point at the file instead:
# GOOGLE_SA_FILE=/config/creed-sheets-creds.json
ORG_SHEET_ID=your-sheet-id

# Gmail send + IMAP reply scan (Google Workspace app password, no spaces)
ORG_GMAIL_ADDRESS=Partnerships@usecreed.com
ORG_GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
REPLY_TO=Jax@usecreed.com
IMAP_HOST=imap.gmail.com

# Days after last touch before a contact is flagged "needs follow-up"
FOLLOWUP_DAYS=5
